[Unit]
Description=GameBoard
After=network-online.target
Wants=network-online.target

[Service]
User=gameboard
Group=gameboard
WorkingDirectory=/var/lib/gameboard
ExecStart=/opt/gameboard/gameboard
Environment=ADDR=127.0.0.1:8080
Environment=DB_PATH=/var/lib/gameboard/gameboard.db
Environment=TRUST_PROXY=true
Environment=COOKIE_SECURE=true
# Optional secrets/overrides (TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET, STEAM_COUNTRY, ...)
EnvironmentFile=-/etc/gameboard/env
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/gameboard

[Install]
WantedBy=multi-user.target
